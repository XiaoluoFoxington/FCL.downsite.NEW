.vscode/

# .trae-html-share-packages/ 为 Trae 生成的 html 分享包缓存，已解除跟踪并忽略。
.trae-html-share-packages/

# Python 字节码缓存目录（如 scripts/auto-sync/__pycache__/）
__pycache__/

# TODO: .tmp/ 已被 git 跟踪（历史遗留的构建产物），确认无用后可 git rm -r --cached 解除跟踪。

# 本地托盘版（scripts/auto-sync/local）：
#   config.json 可能含会话 cookie / token，state/缓存/日志/用户图标都是本机运行产物，均不入库
scripts/auto-sync/local/config.json
scripts/auto-sync/local/config.json.*
scripts/auto-sync/local/state.json
scripts/auto-sync/local/state.json.*
scripts/auto-sync/local/state/
scripts/auto-sync/local/cache/
scripts/auto-sync/local/logs/
scripts/auto-sync/local/assets/user-icon.*
